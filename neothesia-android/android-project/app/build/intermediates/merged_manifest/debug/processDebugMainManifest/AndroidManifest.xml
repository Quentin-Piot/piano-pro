<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pianopro.app"
    android:versionCode="1"
    android:versionName="0.4.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false" />

    <application
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="PianoPro" >
        <activity
            android:name="com.pianopro.app.MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|uiMode|screenLayout|smallestScreenSize|density"
            android:exported="true"
            android:label="PianoPro"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" >
            <meta-data
                android:name="android.app.lib_name"
                android:value="neothesia_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>